# ZenOS Project .gitignore
# Generated by bootstrap - customize per project needs

# Runtime (Domain F - ephemeral)
runtime/session/
runtime/analysis/
runtime/notes/
runtime/tasks/

# Knowledge generated (keep ADRs, ignore duplicates)
knowledge/cache/
knowledge/exports/

# Governance state (ephemeral)
governance/state/temp/

# Capability caches
capabilities/cache/

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temp files
*.tmp
*.bak
*.log

# Node/Python/etc (uncomment as needed)
# node_modules/
# __pycache__/
# .venv/

# Build artifacts
dist/
build/